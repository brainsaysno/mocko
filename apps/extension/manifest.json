{
  "manifest_version": 3,
  "name": "Mocko",
  "version": "0.0.1",
  "description": "Mocko Firefox Extension",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Open Mocko popup"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mocko.nrusso.dev/*",
        "https://local.mocko.nrusso.dev/*"
      ],
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "https://mocko.nrusso.dev/*",
    "https://local.mocko.nrusso.dev/*"
  ]
}
